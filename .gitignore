# Pinned upstream clones are reproduced by tools/fetch_third_party.sh
# from third_party/MANIFEST and are never committed.
third_party/rebound/
third_party/cft-fp256/

# Build products
build/
*.o
*.obj
*.a
*.so
*.dll
*.exe
__pycache__/
*.pyc


# Assembled program images are rebuilt by `make programs` from programs/*.cfta
programs/out/
results/sweep.log
results/sweep_followup.log
results/sweep_fp64.log
results/sweep_followup2.log

# scratch build trees and gate output. build[0-9]* are side trees used
# to run a suite while another one is building; only build/ is the one
# the Makefile uses by default.
build[0-9]*/
gate_real.bin
# tests/gate_restart.c writes these beside the binary when it is run
# without --build, which is what a bare ./build/gate_restart does.
gate1_one.bin
gate1_two.bin

# Agent worktrees. `git worktree add` puts them here; each is a
# separate checkout with its own .git file, so `git add -A` would
# stage them as embedded repositories. It did once.
.claude/worktrees/
