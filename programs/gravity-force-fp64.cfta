; gravity's prefactors and the six contributions of a pair; see tools/gen_programs.py

.format   fp64
.deposits 6
.scratch  in 3
.slot     S_DX = 0
.slot     S_DY = 1
.slot     S_DZ = 2
.reg      prefact = r0
.reg      mi = r1
.reg      mj = r2
.reg      negp = r3
.reg      pfj = r4
.reg      pfi = r5
.reg      dx = r6
.reg      dy = r7
.reg      dz = r8
.reg      c = r9

neg  negp, prefact
mul  pfj, negp, mj
mul  pfi, prefact, mi
ldl  dx, S_DX
ldl  dy, S_DY
ldl  dz, S_DZ
mul  c, pfj, dx
deposit c
mul  c, pfj, dy
deposit c
mul  c, pfj, dz
deposit c
mul  c, pfi, dx
deposit c
mul  c, pfi, dy
deposit c
mul  c, pfi, dz
deposit c
halt
