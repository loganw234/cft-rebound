; gravity's accumulate, 4 addends a run; see tools/gen_programs.py

.format   fp256
.deposits 1
.scratch  in 4
.reg      sum = r0
.reg      acc = r3
.reg      t = r4

ldl  t, 0
add  acc, sum, t
ldl  t, 1
add  acc, acc, t
ldl  t, 2
