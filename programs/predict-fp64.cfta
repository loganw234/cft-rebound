; IAS15 position predictor at one substep, FMA form; see tools/gen_programs.py

.format   fp64
.deposits 1
.bank     external
.const    K0
.const    K1
.const    K2
.const    K3
.const    K4
.const    K5
.const    K6
.const    D2
.const    D1
.scratch  in 8
.slot     B0 = 0
.slot     B1 = 1
.slot     B2 = 2
.slot     B3 = 3
.slot     B4 = 4
.slot     B5 = 5
.slot     B6 = 6
.slot     CSX = 7
.reg      x0 = r0
