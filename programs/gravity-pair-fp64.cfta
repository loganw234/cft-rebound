; gravity's pair arithmetic up to the square root; see tools/gen_programs.py

.format   fp64
.deposits 1
.scratch  in 6
.scratch  out 3
.slot     S_XI = 0
.slot     S_XJ = 1
.slot     S_YI = 2
.slot     S_YJ = 3
.slot     S_ZI = 4
.slot     S_ZJ = 5
.slot     S_DX = 0
.slot     S_DY = 1
.slot     S_DZ = 2
.reg      soft2 = r0
.reg      pi = r3
.reg      pj = r4
.reg      dx = r5
.reg      dy = r6
.reg      dz = r7
.reg      s = r8
.reg      t = r9

ldl  pi, S_XI
ldl  pj, S_XJ
sub  dx, pi, pj
ldl  pi, S_YI
ldl  pj, S_YJ
sub  dy, pi, pj
ldl  pi, S_ZI
ldl  pj, S_ZJ
sub  dz, pi, pj
mul  s, dx, dx
mul  t, dy, dy
add  s, s, t
mul  t, dz, dz
add  s, s, t
add  s, s, soft2
stl  dx, S_DX
stl  dy, S_DY
stl  dz, S_DZ
deposit s
halt
